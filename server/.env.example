# Selkie web server configuration.
# Copy to server/.env for local runs, or paste these keys into your host's
# environment (Railway "Variables"). Never commit real values: .env is gitignored.

# ---- Core -------------------------------------------------------------------
# PORT is provided automatically by Railway. Locally it defaults to 4000.
PORT=4000
# Long random string so sessions survive a restart. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SELKIE_SESSION_SECRET=change-me-to-a-long-random-hex-string
# Set to 1 in production (HTTPS) so the session cookie is marked Secure.
SELKIE_SECURE_COOKIES=1
# The built web app the server hosts. Defaults to ../web-vite/dist, which is
# what you want. Only set this if your build output lives elsewhere.
# SELKIE_WEB_ROOT=/absolute/path/to/web-vite/dist

# DANGER: dev login (/auth/dev) bypasses X sign-in. NEVER enable on a public
# deployment. Leave this unset, or 0, anywhere reachable from the internet.
SELKIE_DEV_LOGIN=0

# ---- Sign in with X (required for a public deploy) --------------------------
# From your X developer app (OAuth 2.0). The redirect URI must exactly match a
# callback URL registered on that app.
X_CLIENT_ID=your-x-oauth-client-id
X_CLIENT_SECRET=your-x-oauth-client-secret
# Point this at your public domain. On Railway (single service):
#   https://your-app.up.railway.app/auth/x/callback
# If you front the app with Vercel (proxy setup), use the Vercel domain instead.
X_REDIRECT_URI=https://your-app.up.railway.app/auth/x/callback

# ---- Canton ledger ----------------------------------------------------------
# Package id of the uploaded Selkie DAR. Pin it after `daml build`:
#   daml damlc inspect-dar --json .daml/dist/selkie-0.1.0.dar | jq -r .main_package_id
SELKIE_PKG_ID=your-selkie-dar-package-id
# JSON Ledger API v2 endpoint of your Canton participant.
SELKIE_JSON_API=https://ledger-api-json.participant.example.devnet
# The operator party id (pre-created at onboarding) and its display handle.
SELKIE_OPERATOR=operator-party-id::fingerprint
SELKIE_OPERATOR_HANDLE=@SelkiePay
# The ledger API user Selkie authenticates as.
SELKIE_LEDGER_USER=your-ledger-user-id
# Claim a pre-granted party per handle from the operator's pool (shared devnet).
SELKIE_PARTY_POOL=1

# OAuth2 (Keycloak) credentials for the ledger API bearer token.
SELKIE_AUTH_TOKEN_URL=https://keycloak.example/realms/your-realm/protocol/openid-connect/token
SELKIE_AUTH_CLIENT_ID=your-ledger-oauth-client
SELKIE_AUTH_USERNAME=your-ledger-oauth-username
SELKIE_AUTH_PASSWORD=your-ledger-oauth-password
SELKIE_AUTH_AUDIENCE=your-ledger-audience
SELKIE_AUTH_SCOPE=openid

# ---- Real token deposits (CC / cBTC / cETH) ---------------------------------
# Leave a block unset to run without that asset; the app still boots.
SELKIE_CBTC_LEDGER=https://ledger-api-json.participant.example.devnet
SELKIE_CBTC_REGISTRY=https://registry.example/cbtc
SELKIE_CBTC_ADMIN=cbtc-registrar-party::fingerprint
SELKIE_CBTC_PARTY=cbtc-reserve-party::fingerprint
SELKIE_CBTC_TOKEN_URL=https://keycloak.example/realms/your-realm/protocol/openid-connect/token
SELKIE_CBTC_CLIENT_ID=your-cbtc-oauth-client
SELKIE_CBTC_USERNAME=your-cbtc-oauth-username
SELKIE_CBTC_PASSWORD=your-cbtc-oauth-password
# cETH rides the same registry host under its own registrar admin.
SELKIE_CETH_ADMIN=ceth-registrar-party::fingerprint
# SELKIE_CETH_REGISTRY defaults to SELKIE_CBTC_REGISTRY when unset.

# ---- Optional ---------------------------------------------------------------
# Where the activity log is written (default ../.data/history.jsonl).
# SELKIE_HISTORY=/absolute/path/to/history.jsonl
# How often to sweep for incoming deposits, in milliseconds (default 8000).
# SELKIE_SWEEP_MS=8000
